  <title>Terms of Service — vorq</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --black: #0a0a0a;
      --white: #ffffff;
      --grey-100: #f5f5f5;
      --grey-200: #e8e8e8;
      --grey-400: #999999;
      --grey-600: #555555;
      --grey-800: #222222;
      --purple: #534AB7;
      --purple-light: #EEEDFe;
      --red: #dc2626;
      --red-light: #fef2f2;
      --green: #16a34a;
      --green-light: #f0fdf4;
      --yellow: #d97706;
      --yellow-light: #fffbeb;
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--white);
      color: var(--grey-800);
      line-height: 1.7;
      font-size: 15px;
    }

    /* Header */
    .header {
      background: var(--black);
      padding: 20px 0;
      position: sticky;
      top: 0;
      z-index: 100;
      border-bottom: 1px solid #1a1a1a;
    }

    .header-inner {
      max-width: 780px;
      margin: 0 auto;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-size: 22px;
      font-weight: 700;
      color: var(--white);
      letter-spacing: -0.5px;
    }

    .last-updated {
      font-size: 12px;
      color: var(--grey-400);
    }

    /* Hero */
    .hero {
      background: var(--black);
      padding: 64px 24px 56px;
      text-align: center;
      border-bottom: 1px solid #1a1a1a;
    }

    .hero-badge {
      display: inline-block;
      background: #1a1a1a;
      border: 1px solid #2a2a2a;
      color: var(--grey-400);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 100px;
      margin-bottom: 20px;
    }

    .hero h1 {
      font-size: 40px;
      font-weight: 700;
      color: var(--white);
      letter-spacing: -1px;
      line-height: 1.2;
      margin-bottom: 14px;
    }

    .hero p {
      font-size: 15px;
      color: var(--grey-400);
      max-width: 480px;
      margin: 0 auto;
      line-height: 1.7;
    }

    /* Container */
    .container {
      max-width: 780px;
      margin: 0 auto;
      padding: 56px 24px 80px;
    }

    /* TOC */
    .toc {
      background: var(--grey-100);
      border-radius: 14px;
      padding: 28px 32px;
      margin-bottom: 56px;
    }

    .toc h2 {
      font-size: 13px;
      font-weight: 600;
      color: var(--grey-600);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 16px;
    }

    .toc ol {
      padding-left: 18px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 32px;
    }

    .toc li { font-size: 13px; }

    .toc a {
      color: var(--purple);
      text-decoration: none;
      font-weight: 500;
    }

    .toc a:hover { text-decoration: underline; }

    /* Sections */
    .section {
      margin-bottom: 52px;
      scroll-margin-top: 80px;
    }

    .section-number {
      font-size: 11px;
      font-weight: 600;
      color: var(--purple);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }

    .section h2 {
      font-size: 22px;
      font-weight: 700;
      color: var(--black);
      letter-spacing: -0.4px;
      margin-bottom: 20px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--grey-200);
    }

    .section h3 {
      font-size: 15px;
      font-weight: 600;
      color: var(--black);
      margin-top: 28px;
      margin-bottom: 10px;
    }

    .section p {
      font-size: 15px;
      color: var(--grey-600);
      line-height: 1.75;
      margin-bottom: 14px;
    }

    .section ul, .section ol {
      padding-left: 20px;
      margin-bottom: 14px;
    }

    .section li {
      font-size: 15px;
      color: var(--grey-600);
      line-height: 1.7;
      margin-bottom: 6px;
    }

    /* Info cards */
    .info-card {
      border-radius: 12px;
      padding: 20px 24px;
      margin: 20px 0;
    }

    .info-card.purple {
      background: var(--purple-light);
      border-left: 3px solid var(--purple);
    }

    .info-card.red {
      background: var(--red-light);
      border-left: 3px solid var(--red);
    }

    .info-card.green {
      background: var(--green-light);
      border-left: 3px solid var(--green);
    }

    .info-card.yellow {
      background: var(--yellow-light);
      border-left: 3px solid var(--yellow);
    }

    .info-card p {
      margin-bottom: 0;
      font-size: 14px;
      color: var(--grey-800);
    }

    .info-card strong { color: var(--black); }

    /* Table */
    .data-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
      font-size: 14px;
    }

    .data-table th {
      background: var(--black);
      color: var(--white);
      padding: 12px 16px;
      text-align: left;
      font-weight: 500;
      font-size: 13px;
    }

    .data-table th:first-child { border-radius: 8px 0 0 0; }
    .data-table th:last-child { border-radius: 0 8px 0 0; }

    .data-table td {
      padding: 12px 16px;
      border-bottom: 1px solid var(--grey-200);
      color: var(--grey-600);
      vertical-align: top;
    }

    .data-table tr:last-child td { border-bottom: none; }
    .data-table tr:nth-child(even) td { background: var(--grey-100); }

    /* Highlight box */
    .highlight-box {
      background: var(--black);
      border-radius: 14px;
      padding: 28px 32px;
      margin: 28px 0;
    }

    .highlight-box h3 {
      color: var(--white);
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .highlight-box p {
      color: var(--grey-400);
      font-size: 14px;
      line-height: 1.7;
      margin-bottom: 0;
    }

    .highlight-box ul {
      padding-left: 18px;
      margin-top: 10px;
    }

    .highlight-box li {
      color: var(--grey-400);
      font-size: 14px;
      line-height: 1.7;
      margin-bottom: 5px;
    }

    /* Refund box */
    .refund-box {
      background: var(--black);
      border-radius: 16px;
      padding: 32px 36px;
      margin: 28px 0;
    }

    .refund-box h3 {
      color: var(--white);
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 20px;
      letter-spacing: -0.3px;
    }

    .refund-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .refund-item {
      background: #161616;
      border: 1px solid #2a2a2a;
      border-radius: 10px;
      padding: 16px 18px;
    }

    .refund-item label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      color: var(--grey-400);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 6px;
    }

    .refund-item span {
      font-size: 14px;
      color: var(--white);
      line-height: 1.5;
    }

    .refund-item.highlight {
      border-color: var(--purple);
      background: #0f0d1f;
    }

    .refund-item.highlight span { color: #a89ee8; }

    /* Contact box */
    .contact-box {
      background: var(--black);
      border-radius: 16px;
      padding: 36px 40px;
      margin-top: 48px;
      text-align: center;
    }

    .contact-box h2 {
      font-size: 22px;
      font-weight: 700;
      color: var(--white);
      margin-bottom: 10px;
      letter-spacing: -0.4px;
    }

    .contact-box p {
      font-size: 14px;
      color: var(--grey-400);
      margin-bottom: 24px;
    }

    .contact-details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      text-align: left;
    }

    .contact-item {
      background: #161616;
      border: 1px solid #2a2a2a;
      border-radius: 10px;
      padding: 16px 18px;
    }

    .contact-item label {
      display: block;
      font-size: 11px;
      font-weight: 500;
      color: var(--grey-400);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 5px;
    }

    .contact-item span { font-size: 14px; color: var(--white); }
    .contact-item a { color: var(--purple); text-decoration: none; font-size: 14px; }

    /* Footer */
    .footer {
      background: var(--grey-100);
      border-top: 1px solid var(--grey-200);
      padding: 28px 24px;
      text-align: center;
    }

    .footer p { font-size: 13px; color: var(--grey-400); line-height: 1.6; }
    .footer strong { color: var(--grey-600); }

    /* Responsive */
    @media (max-width: 600px) {
      .hero h1 { font-size: 28px; }
      .toc ol { grid-template-columns: 1fr; }
      .refund-grid { grid-template-columns: 1fr; }
      .contact-details { grid-template-columns: 1fr; }
      .header-inner { flex-direction: column; gap: 6px; text-align: center; }
    }
  </style>
</head>
